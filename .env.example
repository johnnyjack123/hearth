# Template for the .env next to docker-compose.yml: copy it, adjust it,
# never commit it. Only PUBLIC_URL is required; everything else has
# sensible defaults. Details: docs/deploy.md

# Address under which browsers and Windows computers reach the server. It
# appears in the pairing link and decides which address the sign-in cookies
# are valid for. Behind a reverse proxy, use the https address, for example
# https://hearth.example.org
PUBLIC_URL=http://192.168.1.50:8080

# Port on the host; behind a reverse proxy bind it locally only, for
# example 127.0.0.1:8080.
HEARTH_PORT=8080

# Image version: latest (state of main), sha-<commit> or a version number.
HEARTH_IMAGE_TAG=latest

# Secret for sessions and for encrypting the API keys, at least 32
# characters (openssl rand -base64 48). Empty: the server creates one in
# data/server-secret. If it is lost, the stored keys are lost with it.
HEARTH_SECRET=

# Further addresses of the web app, comma-separated.
TRUSTED_ORIGINS=

# Behind a reverse proxy: its address or network, comma-separated, also as
# a range (for example 172.18.0.0/16). The server trusts X-Forwarded-For
# only from there.
TRUSTED_PROXIES=

# Setup code for the first account. Empty: the server creates one and writes
# it to its log as long as no account exists.
HEARTH_SETUP_CODE=

# Postgres instead of SQLite: set a password (letters and digits only, for
# example openssl rand -hex 32) and uncomment the two lines below.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://hearth:<POSTGRES_PASSWORD>@postgres:5432/hearth
# COMPOSE_PROFILES=postgres

# Web search with SearXNG: add the profile search (with Postgres:
# COMPOSE_PROFILES=postgres,search) and set a secret of your own
# (openssl rand -hex 32).
# COMPOSE_PROFILES=search
SEARXNG_SECRET=
