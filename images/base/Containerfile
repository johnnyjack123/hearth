# Base image for harness instances (docs/ROADMAP.md, Phase 2, package 3).
#
# Built inside the VM by `harness image build`; this directory is embedded into
# the CLI binary, so every file COPY'd below must also be listed in
# crates/harness-core/src/image.rs.
#
# Multi-arch: every source image below is published for linux/amd64 and
# linux/arm64, and nothing here hard-codes an architecture.
#
# Harnesses (pi, ...) are not part of the image. They live in the shared tools
# volume at /opt/harness-tools, so they can be updated without a rebuild
# (ARCHITECTURE.md 3.2). Compilers and other languages are not either: they
# come from the app catalog, one volume each (crates/harness-core/src/apps.rs);
# C/C++ (gcc, g++, make) is switched on by default.

# Node 24 is the current LTS and still ships corepack (removed from Node 25+).
# When moving to Node 26, install corepack via npm instead.
ARG NODE_MAJOR=24
ARG UV_VERSION=0.12.24

FROM docker.io/library/node:${NODE_MAJOR}-trixie-slim AS node
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM docker.io/library/debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      fd-find \
      git \
      jq \
      less \
      micro \
      nano \
      procps \
      python3 \
      python3-venv \
      ripgrep \
      unzip \
      xz-utils \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd

# Node from the official image instead of a distro package or tarball: pinned
# major, right architecture, no extra apt repository or checksum handling.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
 && corepack enable pnpm

COPY --from=uv /uv /uvx /usr/local/bin/

# UID 1000 matches `--userns=keep-id:uid=1000` in the provider, so files in
# volumes belong to the unprivileged VM user. The mount points exist in the
# image so fresh volumes inherit agent ownership on first mount.
RUN useradd --uid 1000 --user-group --create-home --shell /bin/bash agent \
 && mkdir -p /workspace /opt/harness-tools/bin \
 && chown agent:agent /workspace /opt/harness-tools /opt/harness-tools/bin

COPY gitconfig /etc/gitconfig
COPY profile.sh /etc/profile.d/harness.sh

# The gateway is reachable under this name in every project network
# (network alias of the gateway container). Instances have no other route out.
ARG HARNESS_PROXY=http://gateway:8888

# - The root filesystem is read-only at runtime, so `npm install -g` goes to the
#   home volume and pnpm is fetched by corepack into ~/.cache on first use.
# - Corepack must neither prompt (agents cannot answer) nor pin a
#   `packageManager` into the user's package.json.
# - NODE_USE_ENV_PROXY makes Node's built-in fetch, which the LLM SDKs use,
#   honour HTTP(S)_PROXY; without it pi could not reach its provider.
# - Lower- and upper-case proxy variables: curl only reads lower-case
#   http_proxy, other tools only the upper-case ones.
# - uv's cache and the project venv sit on different volumes, so hardlinks
#   fail anyway; copying avoids a warning on every install.
ENV LANG=C.UTF-8 \
    PATH=/opt/harness-tools/bin:/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    NPM_CONFIG_PREFIX=/home/agent/.local \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_ENABLE_AUTO_PIN=0 \
    UV_LINK_MODE=copy \
    NODE_USE_ENV_PROXY=1 \
    HTTP_PROXY=${HARNESS_PROXY} \
    HTTPS_PROXY=${HARNESS_PROXY} \
    http_proxy=${HARNESS_PROXY} \
    https_proxy=${HARNESS_PROXY} \
    NO_PROXY=localhost,127.0.0.1,::1 \
    no_proxy=localhost,127.0.0.1,::1

LABEL org.opencontainers.image.title="harness-base" \
      org.opencontainers.image.description="Base image for llm-harness instances"

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
