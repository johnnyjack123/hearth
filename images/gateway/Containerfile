# Egress gateway of llm-harness projects (crates/harness-gateway).
#
# Built inside the VM by `harness image build`. The context is this file plus
# the gateway crate's Cargo.toml and src/, all embedded into the CLI binary
# (crates/harness-core/src/image.rs). The crate has no dependencies, so the
# build runs offline and needs nothing but the Rust image.
#
# Multi-arch: both source images exist for linux/amd64 and linux/arm64.

# Same toolchain as on the development machine.
ARG RUST_VERSION=1.97

FROM docker.io/library/rust:${RUST_VERSION}-slim-trixie AS build
WORKDIR /src
COPY Cargo.toml ./
COPY src ./src
# Release profile set here rather than in Cargo.toml: there it would be
# ignored (with a warning) while the crate is a workspace member.
ENV CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_STRIP=true
RUN cargo build --release --offline --bin harness-gateway

# Same base as the instances, already in the VM; glibc for the resolver.
FROM docker.io/library/debian:trixie-slim
COPY --from=build /src/target/release/harness-gateway /usr/local/bin/harness-gateway

LABEL org.opencontainers.image.title="harness-gateway" \
      org.opencontainers.image.description="Egress gateway for llm-harness instances"

# nobody; the provider sets the same user explicitly.
USER 65534:65534
EXPOSE 8888
CMD ["harness-gateway", "serve"]
